<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F5FA"
    tools:context=".Diet">

    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- PAGE TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diet"
                android:textColor="#211B2D"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Track your meals and daily nutrition"
                android:textColor="#77717F"
                android:textSize="14sp" />

            <!-- SEARCH -->
            <EditText
                android:id="@+id/foodSearchInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/card_background"
                android:hint="Search food or ingredient"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#211B2D"
                android:textColorHint="#8C8791"
                android:textSize="14sp" />

            <!-- BARCODE -->
            <Button
                android:id="@+id/barcodeButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="BARCODE"
                android:textColor="#673AB7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- DAILY SUMMARY -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="DAILY SUMMARY"
                android:textColor="#211B2D"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_background"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CALORIC BUDGET"
                    android:textColor="#673AB7"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- CONSUMED -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Consumed"
                        android:textColor="#77717F"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/consumedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consumed: 1,450 kcal"
                        android:textColor="#211B2D"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- BURNED -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Burned"
                        android:textColor="#77717F"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/burnedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Burned: 450 kcal"
                        android:textColor="#211B2D"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- REMAINING -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Remaining"
                        android:textColor="#77717F"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/remainingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remaining: 1,200 kcal"
                        android:textColor="#673AB7"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- MEAL LOGS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="MEAL LOGS"
                android:textColor="#211B2D"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Loaded from PulseFit API"
                android:textColor="#77717F"
                android:textSize="12sp" />

            <!-- BREAKFAST CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_background"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/breakfastText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Breakfast    420 kcal"
                    android:textColor="#211B2D"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- LUNCH CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lunchText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lunch    650 kcal"
                    android:textColor="#211B2D"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- DINNER CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dinnerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dinner    -- kcal"
                    android:textColor="#211B2D"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ADD MEAL -->
            <Button
                android:id="@+id/addMealButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/primary_button_background"
                android:text="+ ADD MEAL ENTRY"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

    <!-- FIXED BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bottom_nav_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:singleLine="true"
            android:text="HOME"
            android:textColor="#673AB7"
            android:textSize="9sp" />

        <Button
            android:id="@+id/mapButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:singleLine="true"
            android:text="MAP"
            android:textColor="#673AB7"
            android:textSize="9sp" />

        <Button
            android:id="@+id/exerciseButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:singleLine="true"
            android:text="EXERCISE"
            android:textColor="#673AB7"
            android:textSize="8sp" />

        <Button
            android:id="@+id/dietButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#673AB7"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:singleLine="true"
            android:text="DIET"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:singleLine="true"
            android:text="SETTINGS"
            android:textColor="#673AB7"
            android:textSize="8sp" />

    </LinearLayout>

</LinearLayout>